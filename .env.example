# ===== Nguồn dữ liệu (chọn 1 hoặc cả 2) =====

# Cách 1: Link lịch công khai (iCloud > Lịch > Chia sẻ > Lịch công khai)
# Nhiều link phân tách bằng dấu phẩy. webcal:// sẽ tự đổi thành https://
ICS_URLS=webcal://p01-caldav.icloud.com/published/2/XXXXXXXX

# Cách 2: iCloud CalDAV (xem được cả lịch riêng tư)
# Tạo mật khẩu ứng dụng tại https://account.apple.com > Đăng nhập và Bảo mật > Mật khẩu ứng dụng
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Chỉ lấy một số lịch (tên, phân tách bằng dấu phẩy). Để trống = tất cả
ICLOUD_CALENDARS=

# ===== Hiển thị =====
TIMEZONE=Asia/Ho_Chi_Minh
LANGUAGE=vi
# Số ngày hiển thị ở trang chủ (lịch sắp tới)
AGENDA_DAYS=7
# Kindle tự tải lại trang sau N giây (0 = tắt)
REFRESH_SECONDS=300
# Thời gian giữ cache dữ liệu lịch (phút)
CACHE_MINUTES=10

# ===== Bảo mật (khuyến nghị nếu đưa lên Internet) =====
# Nếu đặt, truy cập bằng http://host:8000/?key=GIÁ_TRỊ
ACCESS_TOKEN=

# Chạy thử với dữ liệu mẫu, không cần tài khoản Apple
DEMO=0
